# Application
VITE_APP_NAME="2SI SARL - Commerce Hub"
VITE_APP_VERSION="2.0.0"
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=https://2si.up.railway.app/api/v1
VITE_API_TIMEOUT=30000

# Activation des modules & fonctionnalités métier
# → Gérée EN DUR dans src/config/features.config.ts (plus via l'environnement).
#   Pour activer/désactiver une fonctionnalité, éditer ce fichier.

# Payment & Licensing (futur)
# VITE_LICENSE_KEY=
# VITE_LICENSE_EXPIRY=

# Analytics (optionnel)
# VITE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Maintenance Mode
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_MESSAGE="Le système est en maintenance. Veuillez réessayer plus tard."
